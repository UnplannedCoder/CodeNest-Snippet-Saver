# Server Configuration
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/codenest

# JWT Secret Key for token signing
JWT_SECRET=your_jwt_secret_key_here

# Notification Recipient (where all alerts are sent)
ADMIN_EMAIL=pawansa2006@gmail.com

# --- OPTION 1: HTTPS Webhook (Recommended for Render / Cloud Free Tiers) ---
# Create in 1 min on script.google.com -> Deploy as Web App -> Paste URL here
EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# --- OPTION 2: Resend HTTP REST API (Cloud Alternative) ---
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=CodeNest Alerts <onboarding@resend.dev>

# --- OPTION 3: Gmail SMTP (For Local Development or Servers with Open SMTP) ---
# Generate 16-character app password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password_here
